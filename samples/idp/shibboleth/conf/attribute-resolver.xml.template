<AttributeResolver xmlns="urn:mace:shibboleth:2.0:resolver" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:mace:shibboleth:2.0:resolver https://shibboleth.net/schema/idp/shibboleth-attribute-resolver.xsd">
  <AttributeDefinition id="uid" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="uid"/><AttributeEncoder xsi:type="SAML2String" name="uid" friendlyName="uid" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="mail" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="mail"/><AttributeEncoder xsi:type="SAML2String" name="mail" friendlyName="mail" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="displayName" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="displayName"/><AttributeEncoder xsi:type="SAML2String" name="displayName" friendlyName="displayName" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="employeeNumber" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="employeeNumber"/><AttributeEncoder xsi:type="SAML2String" name="employeeNumber" friendlyName="employeeNumber" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="eduPersonAffiliation" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="eduPersonAffiliation"/><AttributeEncoder xsi:type="SAML2String" name="eduPersonAffiliation" friendlyName="eduPersonAffiliation" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="eduPersonPrincipalName" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="eduPersonPrincipalName"/><AttributeEncoder xsi:type="SAML2String" name="eduPersonPrincipalName" friendlyName="eduPersonPrincipalName" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="givenName" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="givenName"/><AttributeEncoder xsi:type="SAML2String" name="givenName" friendlyName="givenName" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="sn" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="sn"/><AttributeEncoder xsi:type="SAML2String" name="sn" friendlyName="sn" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <AttributeDefinition id="memberOf" xsi:type="Simple"><InputDataConnector ref="ldap" attributeNames="memberOf"/><AttributeEncoder xsi:type="SAML2String" name="memberOf" friendlyName="memberOf" nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/></AttributeDefinition>
  <DataConnector id="ldap" xsi:type="LDAPDirectory" ldapURL="%{idp.attribute.resolver.LDAP.ldapURL}" baseDN="%{idp.attribute.resolver.LDAP.baseDN}" principal="%{idp.attribute.resolver.LDAP.bindDN}" principalCredential="%{idp.attribute.resolver.LDAP.bindDNCredential}" useStartTLS="false">
    <FilterTemplate><![CDATA[(uid=$resolutionContext.principal)]]></FilterTemplate>
    <ReturnAttributes>uid mail displayName employeeNumber eduPersonAffiliation eduPersonPrincipalName givenName sn memberOf</ReturnAttributes>
  </DataConnector>
</AttributeResolver>
