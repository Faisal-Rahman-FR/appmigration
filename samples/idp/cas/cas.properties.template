server.port=8080
server.ssl.enabled=false
server.forward-headers-strategy=native
server.tomcat.remoteip.internal-proxies=.*
cas.server.name=@@CAS_ORIGIN@@
cas.server.prefix=@@CAS_ORIGIN@@/cas
cas.service-registry.core.init-from-json=false
cas.service-registry.json.location=file:/etc/cas/services
cas.authn.accept.enabled=false
cas.authn.accept.users=
cas.authn.ldap[0].type=AUTHENTICATED
cas.authn.ldap[0].ldap-url=ldap://ldap:389
cas.authn.ldap[0].use-start-tls=false
cas.authn.ldap[0].base-dn=ou=people,dc=demo,dc=test
cas.authn.ldap[0].search-filter=(uid={user})
cas.authn.ldap[0].bind-dn=cn=readonly,dc=demo,dc=test
cas.authn.ldap[0].bind-credential=@@LDAP_BIND_PASSWORD@@
cas.authn.ldap[0].principal-attribute-id=uid
cas.authn.ldap[0].principal-attribute-list=uid,mail,displayName,employeeNumber,memberOf,eduPersonAffiliation,eduPersonPrincipalName,givenName,sn
cas.authn.ldap[0].allow-multiple-principal-attribute-values=true
cas.logout.follow-service-redirects=true
cas.slo.disabled=false
cas.slo.asynchronous=false
cas.webflow.crypto.signing.key=@@CAS_WEBFLOW_SIGNING_KEY@@
cas.webflow.crypto.encryption.key=@@CAS_WEBFLOW_ENCRYPTION_KEY@@
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never
