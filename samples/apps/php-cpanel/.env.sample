PORT=9000
# ALUMNI_AUTH selects the protocol: cas (default, rollback path) or entra.
ALUMNI_AUTH=cas
CAS_ORIGIN=https://cas.demo.test
ALUMNI_ORIGIN=https://alumni.demo.test
CAS_CA_FILE=/tls/ca.crt
SLO_PROXY_HOST=gateway
DB_HOST=db
# For ALUMNI_AUTH=entra (single-tenant GUID; never common/organizations):
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# The client secret is NOT an environment variable: put it in a 0600 file above the web root,
# /home/<user>/.config/alumni-entra.php, containing: <?php return ['client_secret' => '...'];
# DB_PASSWORD is locally generated; never commit.
